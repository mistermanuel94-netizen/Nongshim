# Production origin. Drives every canonical URL, the sitemap, Open Graph URLs
# and the JSON-LD @id graph. Building with the wrong value produces incorrect
# canonicals site-wide — see docs/deployment.md.
SITE_URL=https://eng.nongshim.com

# Optional. Where the contact enquiry form posts. Without it, the page shows the
# published phone number and postal address and says the form is not connected;
# it never renders a form that silently discards input.
# PUBLIC_CONTACT_ENDPOINT=https://forms.example.com/nongshim
