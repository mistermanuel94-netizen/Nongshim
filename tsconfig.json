{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro", "**/*.tsx"],
  "exclude": ["dist", "node_modules", "tools/scratch"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowJs": true,
    "strictNullChecks": true,
    "verbatimModuleSyntax": true
  }
}
