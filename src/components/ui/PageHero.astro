---
/**
 * The section page hero, reproducing the source's jumbotron: full-bleed image,
 * heading, and the brand rule-and-dot motif above a short description.
 *
 * The heading is the page's `<h1>` — on the source site the `<h1>` was the
 * logo on every page, so every page shared one non-descriptive H1.
 *
 * When the hero image is the page's LCP element, the page prepares it with
 * `prepareLcpImage()` and passes the result in as `lcpImage`; the same object
 * also drives the `<link rel="preload">` in the head, so the preload and the
 * rendered element can never disagree.
 */
import { Image } from 'astro:assets';
import { resolveImage, type ContentImage } from '../../lib/images';
import type { PreparedImage } from '../../lib/lcp';

interface Props {
  heading: string;
  description?: string | null;
  eyebrow?: string | null;
  image?: ContentImage | null;
  /** Prepared LCP image, when this hero is the page's largest paint. */
  lcpImage?: PreparedImage | null;
}

const { heading, description, eyebrow, image, lcpImage = null } = Astro.props;
const hero = resolveImage(image);
const hasImage = Boolean(lcpImage ?? hero);
---

<section class={`page-hero${hasImage ? '' : ' page-hero--plain'}`}>
  {
    lcpImage ? (
      /* Decorative: the heading beside it carries the meaning. */
      <img
        {...lcpImage.attrs}
        alt=""
        aria-hidden="true"
        class="page-hero__image"
      />
    ) : (
      hero && (
        <Image
          class="page-hero__image"
          src={hero.src}
          alt=""
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      )
    )
  }
  <div class="page-hero__body container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{heading}</h1>
    {
      description && (
        <>
          <span class="brand-rule" aria-hidden="true" />
          <p class="lede">{description}</p>
        </>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: grid;
    isolation: isolate;
    min-height: clamp(15rem, 34vw, 26rem);
    align-content: center;
    padding-block: var(--space-8);
    background: var(--color-surface-inverse);
    color: #fff;
  }

  .page-hero--plain {
    min-height: 0;
    padding-block: var(--space-8) var(--space-6);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .page-hero__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The source overlaid text directly on photography, so contrast depended on
     the picture. A fixed dark scrim makes the text ground deterministic: the
     lightest possible result is #3c3c3c, which clears 4.5:1 for the body copy
     and for the heading. */
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(12 12 12 / 0.62), rgb(12 12 12 / 0.76));
  }

  .page-hero--plain::before {
    display: none;
  }

  .page-hero__body {
    position: relative;
  }

  .page-hero h1 {
    margin: 0;
    color: inherit;
  }

  .page-hero--plain h1 {
    color: var(--color-text-strong);
  }

  .page-hero .lede {
    margin: 0;
    color: inherit;
  }

  .page-hero .eyebrow {
    color: var(--color-brand-primary);
  }

  .page-hero--plain .eyebrow {
    color: var(--color-brand-primary-text);
  }

  .page-hero .brand-rule {
    display: flex;
    margin-block: var(--space-4);
  }
</style>
