---
/**
 * Recipe card. Shows the recipe's own photography, its summary line and the
 * Nongshim products it uses — the source card showed only a title and image.
 */
import { Image } from 'astro:assets';
import LcpImage from '../ui/LcpImage.astro';
import { resolveImage } from '../../lib/images';
import type { PreparedImage } from '../../lib/lcp';
import type { Recipe } from '../../lib/content';

interface Props {
  recipe: Recipe;
  priority?: boolean;
  /** Heading level, so a card never skips a level in the page outline. */
  headingLevel?: 2 | 3;
  /** Set on the one card that is the page's LCP element; it is preloaded. */
  lcp?: PreparedImage | null;
}

const { recipe, priority = false, headingLevel = 3, lcp = null } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const image = resolveImage(recipe.heroImage);
---

<article class="recipe-card">
  <a class="recipe-card__link" href={recipe.path}>
    <div class="recipe-card__media">
      {
        lcp ? (
          <LcpImage image={lcp} class="recipe-card__image" />
        ) : image ? (
          <Image
            src={image.src}
            alt={image.alt}
            widths={[240, 360, 540, 720]}
            sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 33vw, 100vw"
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding="async"
            class="recipe-card__image"
          />
        ) : (
          /* Ten recipes have no usable photograph on the source CDN. Rather
             than substitute a stock image, the card falls back to type. */
          <span class="recipe-card__fallback" aria-hidden="true">
            <span class="brand-rule" />
          </span>
        )
      }
    </div>
    <div class="recipe-card__body">
      <Heading class="recipe-card__name">{recipe.name}</Heading>
      {recipe.summary && <p class="recipe-card__summary">{recipe.summary}</p>}
      {
        recipe.relatedProducts.length > 0 && (
          <p class="recipe-card__uses">
            <span class="visually-hidden">Made with </span>
            {recipe.relatedProducts.map((p) => p.name).join(' · ')}
          </p>
        )
      }
    </div>
  </a>
</article>

<style>
  .recipe-card {
    height: 100%;
  }

  .recipe-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #fff;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .recipe-card__link:hover {
    border-color: var(--color-brand-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .recipe-card__media {
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
    overflow: hidden;
  }

  .recipe-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recipe-card__fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-surface), var(--color-surface-strong));
  }

  .recipe-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .recipe-card__name {
    margin: 0;
    font-size: var(--text-md);
    line-height: var(--leading-snug);
  }

  .recipe-card__summary {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .recipe-card__uses {
    margin: auto 0 0;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-brand-primary-text);
  }
</style>
