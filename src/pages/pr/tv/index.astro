---
/**
 * Nongshim TV — the corporate and brand film library.
 *
 * 31 films with their published English transcripts. The source embedded a
 * YouTube iframe eagerly on load; here each film is a lazy `<iframe>` behind a
 * facade, so the page ships no third-party JavaScript until a visitor plays
 * something. The transcript text is real page content, which is what makes the
 * library searchable at all — video alone is opaque to search and to AI.
 */
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import { resolveImage } from '../../../lib/images';
import { prepareLcpImage } from '../../../lib/lcp';
import { videos } from '../../../lib/content';
import { graph, organizationSchema, breadcrumbSchema, canonical } from '../../../lib/seo';

const path = '/pr/tv/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Press', path: '/press/' },
  { name: 'Nongshim TV', path },
];

const list = videos.videos;
const description = `${list.length} Nongshim brand and corporate films, each with its published English transcript.`;
const hero = resolveImage(videos.heroImage);
const heroLcp = await prepareLcpImage(hero, { widths: [640, 960, 1280, 1920], sizes: '100vw' });

const schema = graph([
  organizationSchema(),
  {
    '@type': 'CollectionPage',
    '@id': `${canonical(path)}#webpage`,
    url: canonical(path),
    name: 'Nongshim TV',
    description,
    inLanguage: 'en',
    isPartOf: { '@id': `${canonical('/')}#website` },
  },
  {
    '@type': 'ItemList',
    name: 'Nongshim films',
    numberOfItems: list.length,
    itemListElement: list.map((v, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        // VideoObject requires an uploadDate and a thumbnail. The source
        // publishes neither for these films (regDate is a CMS record date, not
        // a publication date), so only name and embedUrl are asserted.
        '@type': 'VideoObject',
        name: v.title,
        embedUrl: `https://www.youtube.com/embed/${v.youtubeId}`,
        url: `https://www.youtube.com/watch?v=${v.youtubeId}`,
      },
    })),
  },
  breadcrumbSchema(crumbs),
]);
---

<Base
  title="Nongshim TV"
  description={description}
  path={path}
  image={hero?.src.src}
  ogType="article"
  breadcrumbs={crumbs}
  schema={schema}
  preloadImage={heroLcp?.preload}
>
  <PageHero
    heading="Nongshim TV"
    eyebrow="Press"
    description={videos.description ?? 'Brand and corporate films published by Nongshim.'}
    image={videos.heroImage}
    lcpImage={heroLcp}
  />

  <div class="container section">
    <p class="lede">{list.length} films, each with the transcript Nongshim publishes alongside it.</p>

    <ul class="films">
      {
        list.map((video) => (
          <li class="film" id={`film-${video.id}`}>
            <h2>{video.title}</h2>
            <div class="film__player">
              {/* `srcdoc` keeps YouTube's player scripts out of the page until
                  the visitor presses play; the frame then loads normally. */}
              <iframe
                title={`${video.title} — video`}
                src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}?rel=0`}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                width="560"
                height="315"
              />
            </div>
            {video.transcript.length > 0 && (
              <details class="film__transcript">
                <summary>Transcript</summary>
                <div class="prose">
                  {video.transcript.map((line) => (
                    <p>{line}</p>
                  ))}
                </div>
              </details>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .films {
    display: grid;
    gap: var(--space-8);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .film {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--header-height) + var(--space-4));
  }

  .film h2 {
    font-size: var(--text-xl);
  }

  .film__player {
    max-width: 44rem;
  }

  .film__player iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-surface-inverse);
  }

  .film__transcript {
    margin-top: var(--space-4);
    max-width: var(--container-narrow);
  }

  .film__transcript summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }

  .film__transcript summary:hover {
    border-color: var(--color-brand-primary);
    color: var(--color-brand-primary-text);
  }

  .film__transcript .prose {
    margin-top: var(--space-4);
    padding-left: var(--space-5);
    border-left: 3px solid var(--color-brand-primary);
  }
</style>
